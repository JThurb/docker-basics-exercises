# Base image
FROM golang:1.16

# port variablena
ENV PORT=8080

# request origin
ENV REQUEST_ORIGIN=http://127.0.0.1:5001

# working directory
WORKDIR /usr/src/app

# copy app code friom directory 1_13
COPY 1_13 .

# Expose port
EXPOSE $PORT

#Run "go build"
RUN go build

# Run test
RUN go test ./...

# Execute project
CMD ["./server"]

